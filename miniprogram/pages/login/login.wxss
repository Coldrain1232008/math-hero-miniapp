/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
  position: relative;
  overflow: hidden;
}

/* 背景光晕装饰 */
.bg-glow {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.bg-glow-1 {
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(108,99,255,0.25) 0%, transparent 70%);
  top: -160rpx;
  right: -160rpx;
}
.bg-glow-2 {
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(168,85,247,0.2) 0%, transparent 70%);
  bottom: -100rpx;
  left: -100rpx;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 72rpx;
  position: relative;
  z-index: 1;
}

/* 徽章式 logo */
.logo-emblem {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}

.emblem-ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(108,99,255,0.5);
  animation: ring-pulse 3s ease-in-out infinite;
}
.emblem-ring-outer {
  width: 180rpx;
  height: 180rpx;
  border-color: rgba(108,99,255,0.35);
  animation-delay: 0s;
}
.emblem-ring-inner {
  width: 140rpx;
  height: 140rpx;
  background: rgba(108,99,255,0.18);
  border-color: rgba(108,99,255,0.6);
  animation-delay: 0.5s;
}
@keyframes ring-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.06); opacity: 0.7; }
}

.logo-icon {
  font-size: 80rpx;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 0 12rpx rgba(108,99,255,0.8));
}

/* 标题区 */
.title-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.app-title {
  font-size: 50rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 6rpx;
  text-shadow: 0 0 24rpx rgba(108,99,255,0.8), 0 2rpx 8rpx rgba(0,0,0,0.4);
}

/* 标题装饰线 */
.title-deco {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.deco-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(108,99,255,0.8), transparent);
}
.deco-star {
  font-size: 22rpx;
  color: rgba(168,85,247,0.9);
}

.app-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.55);
  letter-spacing: 4rpx;
}

.form-area {
  background: rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid rgba(255,255,255,0.15);
  position: relative;
  z-index: 1;
  backdrop-filter: blur(8px);
}

.input-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 16rpx;
  display: block;
}

.input-field {
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.2);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #fff;
  width: 100%;
  display: block;
  box-sizing: border-box;
  margin-bottom: 40rpx;
}

/* ===== placeholder 自渲染（绕过 native input）=====
   微信 <input> 是原生组件，其 placeholder 由 native 控件绘制，
   不受 CSS line-height 控制，会被裁掉一半。
   改用 webview 的 <text> 浮在 input 上方，user 输入时 wx:if 隐藏。
   ⚠️ 关键：<text> 默认是 inline，inline 上 overflow/text-overflow/max-width
   全部失效，文字按内容宽度撑出去（"对齐不对，跑到输入框外面"）。
   必须 display:block + absolute 配 right 锁定宽度，ellipsis 才会生效。 */
.ph-wrap {
  position: relative;
  width: 100%;
}
.ph {
  display: block;
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 42rpx;
  line-height: 42rpx;
  font-size: 30rpx;
  color: rgba(255,255,255,0.5);
  pointer-events: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ph-modal {
  color: rgba(0,0,0,0.4);
}

.role-switch {
  display: flex;
  background: rgba(0,0,0,0.2);
  border-radius: 50rpx;
  padding: 6rpx;
  margin-bottom: 48rpx;
}

.role-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
  transition: all 0.2s;
}

.role-btn.active {
  background: #6c63ff;
  color: #fff;
  font-weight: 600;
}

.login-btn {
  width: 100%;
  text-align: center;
}

.hint {
  font-size: 24rpx;
  color: rgba(255,255,255,0.35);
  margin-top: 40rpx;
  position: relative;
  z-index: 1;
}

/* ========== 注册新班级入口 ========== */
.register-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 12rpx 32rpx;
  position: relative;
  z-index: 1;
}

.register-entry-text {
  font-size: 26rpx;
  color: rgba(168, 130, 255, 0.95);
}

.register-entry-arrow {
  font-size: 30rpx;
  color: rgba(168, 130, 255, 0.95);
}

/* ========== 注册弹窗（深色，配合登录页主题） ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.68);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 0 48rpx;
}

.modal-box {
  width: 100%;
  background: #221f3d;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
  max-height: 86vh;
  box-sizing: border-box;
  overflow-y: auto;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  margin-bottom: 12rpx;
}

.modal-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  margin-bottom: 40rpx;
}

.modal-input-group {
  margin-bottom: 28rpx;
}

.modal-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 16rpx;
  display: block;
}

.modal-input {
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #fff;
  width: 100%;
  box-sizing: border-box;
}

.modal-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.6;
  margin-bottom: 36rpx;
}

.modal-tip.warn {
  color: rgba(255, 205, 130, 0.9);
}

.modal-tip.sub {
  color: rgba(255, 255, 255, 0.3);
  font-size: 22rpx;
  margin-top: -20rpx;
  margin-bottom: 36rpx;
}

.modal-btn-row {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.7);
}

.modal-btn.confirm {
  background: #6c63ff;
  color: #fff;
  font-weight: 600;
}

/* ========== 创建成功 - 密钥展示 ========== */
.created-class-name {
  text-align: center;
  font-size: 32rpx;
  color: #c084fc;
  font-weight: 600;
  margin-bottom: 36rpx;
}

.key-display {
  background: rgba(0, 0, 0, 0.28);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
}

.key-display-item {
  margin-bottom: 28rpx;
}

.key-display-item:last-child {
  margin-bottom: 0;
}

.key-display-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  display: block;
  margin-bottom: 12rpx;
}

.key-display-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.key-display-value {
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 5rpx;
  font-family: monospace;
}

.btn-copy-sm {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 0 24rpx;
  height: 54rpx;
  line-height: 54rpx;
  background: rgba(108, 99, 255, 0.25);
  color: #a5b4fc;
  border-radius: 27rpx;
  border: 1rpx solid rgba(108, 99, 255, 0.5);
}

.btn-copy-sm::after {
  border: none;
}
