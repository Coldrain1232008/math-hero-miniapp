<!-- pages/shop/shop.wxml
     金币商城（学生端）
     项目硬规则：条件分支节点上不再挂循环指令，循环需拆到内层；
     flex 内的 button 必须在 wxss 里写死宽度四件套；表达式等值判断用 === -->

<view class="page">

  <!-- 余额条 -->
  <view class="balance-bar">
    <view class="balance-left">
      <view class="balance-icon-wrap">🪙</view>
      <view class="balance-info">
        <text class="balance-value">{{balance}}</text>
        <text class="balance-label">我的金币</text>
      </view>
    </view>
    <button class="balance-btn ghost" bindtap="goCoinLogs">明细</button>
  </view>

  <!-- 集合未创建等明确错误 -->
  <view wx:if="{{errorMsg}}" class="error-box">
    <text class="error-text">{{errorMsg}}</text>
  </view>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="state-box">
    <text class="state-text">加载中...</text>
  </view>

  <!-- 内容区 -->
  <view wx:else>
    <!-- 空商店 -->
    <view wx:if="{{items.length === 0}}" class="state-box">
      <text class="state-icon">🏪</text>
      <text class="state-text">商店还没上架商品</text>
      <text class="state-sub">等老师添加商品后再来看看</text>
    </view>

    <!-- 商品列表 -->
    <view wx:else>
      <view class="section-tip">全部商品</view>

      <view wx:for="{{items}}" wx:key="_id" class="shop-item {{item.canBuy ? '' : 'is-disabled'}}">

        <view class="item-head">
          <view class="item-icon-wrap">{{item.icon}}</view>

          <view class="item-info">
            <view class="item-name-row">
              <text class="item-name">{{item.name}}</text>
              <text wx:if="{{item.isGlobal}}" class="item-tag-global">全局</text>
            </view>
            <text class="item-desc">{{item.desc}}</text>
            <view class="item-meta">
              <text wx:if="{{item.stock >= 0}}" class="meta-chip">库存 {{item.stock}}</text>
              <text wx:else class="meta-chip">库存不限</text>
              <text wx:if="{{item.limitPerUser > 0}}" class="meta-chip">
                限购 {{item.boughtTotal}}/{{item.limitPerUser}}
              </text>
              <text wx:if="{{item.limitPerDay > 0}}" class="meta-chip">
                今日 {{item.boughtToday}}/{{item.limitPerDay}}
              </text>
            </view>
          </view>

          <view class="item-right">
            <view class="price-row">
              <text class="price-icon">🪙</text>
              <text class="price-value">{{item.price}}</text>
            </view>
            <button
              class="buy-btn"
              disabled="{{!item.canBuy}}"
              bindtap="openConfirm"
              data-index="{{index}}"
            >购买</button>
          </view>
        </view>

        <!-- 不可购买的原因 -->
        <view wx:if="{{!item.canBuy}}" class="disabled-reason">
          <text class="reason-text">{{item.disabledReason}}</text>
        </view>

      </view>
    </view>
  </view>

</view>

<!-- 购买确认弹窗 -->
<view wx:if="{{showConfirm}}" class="modal-mask" bindtap="closeConfirm">
  <view class="modal-card" catchtap="noop">

    <view class="modal-head">
      <text class="modal-icon">{{confirmItem.icon}}</text>
      <text class="modal-title">{{confirmItem.name}}</text>
    </view>

    <text class="modal-desc">{{confirmItem.desc}}</text>

    <view class="qty-row">
      <text class="qty-label">购买数量</text>
      <view class="qty-control">
        <button class="qty-btn" bindtap="minusQty" disabled="{{qty <= 1}}">−</button>
        <text class="qty-value">{{qty}}</text>
        <button class="qty-btn" bindtap="plusQty" disabled="{{qty >= maxQty}}">+</button>
      </view>
    </view>

    <view class="cost-row">
      <text class="cost-label">共需</text>
      <text class="cost-value">🪙 {{totalCost}}</text>
    </view>

    <view class="after-row">
      <text class="after-label">购买后余额</text>
      <text class="after-value">{{balanceAfter}}</text>
    </view>

    <view wx:if="{{!enough}}" class="warn-row">
      <text class="warn-text">金币不足，还差 {{shortage}} 枚</text>
    </view>

    <view class="modal-actions">
      <button class="modal-btn ghost" bindtap="closeConfirm">再想想</button>
      <button class="modal-btn primary" bindtap="doBuy" disabled="{{!enough || buying}}">
        {{buying ? '购买中' : '确认购买'}}
      </button>
    </view>

  </view>
</view>
