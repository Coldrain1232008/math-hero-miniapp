/* pages/super/super.wxss */
/* 深色主题，与登录页 / 角色页保持一致 */

.page {
  min-height: 100vh;
  background: #1a1a2e;
  padding: 32rpx;
  box-sizing: border-box;
}

/* ===== 未登录 ===== */
.login-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.login-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 56rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-icon {
  font-size: 72rpx;
  line-height: 96rpx;
}

.login-title {
  font-size: 40rpx;
  color: #fff;
  font-weight: 500;
  margin-top: 16rpx;
}

.login-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 12rpx;
  margin-bottom: 40rpx;
}

.input-group {
  width: 100%;
}

.input-field {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  color: #fff;
  font-size: 30rpx;
}

/* ===== placeholder 自渲染（绕过 native input）=====
   三件套缺一不可：
   1. display:block  —— <text> 默认 inline，inline 上 overflow/ellipsis 全失效
   2. left + right   —— 锁住宽度，比 max-width 稳
   3. top:50% + translateY(-50%) + height=line-height
      —— native input 的视觉中心是 native 算法定的，不是 CSS line-height，
         按 padding-top 对齐会偏低 */
.ph-wrap {
  position: relative;
  width: 100%;
}

.ph {
  display: block;
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 42rpx;
  line-height: 42rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.45);
  pointer-events: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #6c63ff;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  margin-top: 32rpx;
  padding: 0 !important;
  box-sizing: border-box;
}

.btn-primary::after {
  border: none;
}

.error-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #f09595;
}

.login-tip {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  text-align: center;
}

/* ===== 已登录：管理员条 ===== */
.admin-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.admin-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ⚠️ 微信 <button> 有原生 padding:0 14px + margin:0 auto，
   在 flex 里会抢空间挤走邻居，必须用 !important 覆盖 */
.btn-exit {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx !important;
  margin: 0 !important;
  box-sizing: border-box;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
}

.btn-exit::after {
  border: none;
}

/* ===== 总览 ===== */
.overview-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.ov-title {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
  margin-bottom: 28rpx;
}

.ov-grid {
  display: flex;
}

.ov-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 5 列布局，字号相应收窄，避免 6 位数撑破 137rpx 的格子 */
.ov-num {
  font-size: 34rpx;
  color: #ffd166;
  font-weight: 500;
}

/* 商城销毁是金币的"出口"，用另一个色区分于"存量" */
.ov-num.burn {
  color: #f09595;
}

.ov-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 10rpx;
}

.ov-check {
  margin-top: 28rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  box-sizing: border-box;
  text-align: center;
}

.ov-check.ok {
  background: rgba(29, 158, 117, 0.15);
  color: #5dcaa5;
}

.ov-check.bad {
  background: rgba(226, 75, 74, 0.18);
  color: #f09595;
}

/* ===== Tab ===== */
.tab-row {
  display: flex;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  padding: 6rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  border-radius: 10rpx;
}

.tab.active {
  background: #6c63ff;
  color: #fff;
}

/* ===== 班级卡片 ===== */
.class-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.class-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.class-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.class-count {
  flex-shrink: 0;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 16rpx;
}

.class-keys {
  display: flex;
  margin-top: 14rpx;
}

.key-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  background: rgba(255, 255, 255, 0.06);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.class-stats {
  display: flex;
  margin-top: 24rpx;
}

.cs-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cs-num {
  font-size: 32rpx;
  color: #ffd166;
}

.cs-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 8rpx;
}

.btn-recharge {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  margin: 24rpx 0 0 0 !important;
  padding: 0 !important;
  box-sizing: border-box;
  flex-shrink: 0;
  background: rgba(108, 99, 255, 0.18);
  border: 1rpx solid rgba(108, 99, 255, 0.5);
  color: #a9a2ff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.btn-recharge::after {
  border: none;
}

/* ===== 审计日志 ===== */
.log-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.log-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.log-action {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.log-amount {
  font-size: 30rpx;
  color: #5dcaa5;
}

.log-mid {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}

.log-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.log-ba {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.log-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

.log-note {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 10rpx;
}

.empty {
  text-align: center;
  color: rgba(255, 255, 255, 0.4);
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* ===== 全局商品模板 ===== */
.shop-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.shop-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.shop-top {
  display: flex;
  align-items: center;
}

.shop-icon {
  flex-shrink: 0;
  font-size: 48rpx;
  line-height: 56rpx;
  width: 56rpx;
  text-align: center;
}

/* 被 button 挤过的弹性子项老规矩：flex:1 + min-width:0 */
.shop-head {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.shop-name {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.shop-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.shop-price {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #ffd166;
  margin-left: 16rpx;
}

.shop-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.shop-tag {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.06);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin: 0 12rpx 12rpx 0;
}

.shop-tag.global {
  color: #a9a2ff;
  background: rgba(108, 99, 255, 0.16);
}

.shop-tag.on {
  color: #5dcaa5;
  background: rgba(29, 158, 117, 0.16);
}

.shop-tag.off {
  color: #f09595;
  background: rgba(226, 75, 74, 0.16);
}

.shop-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 4rpx;
}

/* ⚠️ flex item 死宽度四件套：只写 min-width 兜不住，
   容器有剩余空间时 flex 会把空间平分给子项，按钮被撑爆 */
.shop-act {
  flex: 0 0 190rpx !important;
  width: 190rpx !important;
  min-width: 190rpx !important;
  max-width: 190rpx !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  box-sizing: border-box;
  font-size: 26rpx;
  text-align: center;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.75);
}

.shop-act.danger {
  color: #f09595;
  background: rgba(226, 75, 74, 0.14);
}

.shop-act::after {
  border: none;
}

.btn-add-shop {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  margin: 24rpx 0 0 0 !important;
  padding: 0 !important;
  box-sizing: border-box;
  flex-shrink: 0;
  background: rgba(108, 99, 255, 0.18);
  border: 1rpx solid rgba(108, 99, 255, 0.5);
  color: #a9a2ff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.btn-add-shop::after {
  border: none;
}

/* ===== 商品编辑弹窗 ===== */
.item-box {
  width: 640rpx;
  padding: 36rpx 32rpx 32rpx;
}

.form-scroll {
  max-height: 60vh;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
}

.icon-cell {
  width: 84rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  margin: 0 12rpx 12rpx 0;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.icon-cell.active {
  border-color: #6c63ff;
  background: rgba(108, 99, 255, 0.18);
}

.picker-view {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.form-row-2 {
  display: flex;
}

.fr-item {
  flex: 1;
  min-width: 0;
}

.fr-item:first-child {
  margin-right: 16rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 4rpx;
  box-sizing: border-box;
}

.sw-label {
  margin-bottom: 0;
}

/* ===== 充值弹窗 ===== */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 600rpx;
  background: #22223a;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-sizing: border-box;
}

.modal-title {
  display: block;
  font-size: 34rpx;
  color: #fff;
  font-weight: 500;
  text-align: center;
}

.modal-sub {
  display: block;
  font-size: 26rpx;
  color: #a9a2ff;
  text-align: center;
  margin-top: 10rpx;
  margin-bottom: 32rpx;
}

.modal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  display: block;
  margin-bottom: 14rpx;
}

.modal-current {
  font-size: 32rpx;
  color: #ffd166;
}

.modal-input-group {
  margin-bottom: 24rpx;
}

.modal-input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  color: #fff;
  font-size: 30rpx;
}

/* 弹窗里的 placeholder：padding 与 modal-input 一致，直接复用 .ph 的定位 */
.ph-modal {
  color: rgba(255, 255, 255, 0.4);
}

.modal-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  margin-top: 8rpx;
}

.modal-btn-row {
  display: flex;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
  margin: 0 !important;
  padding: 0 !important;
  box-sizing: border-box;
}

.modal-btn.cancel {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.6);
  margin-right: 16rpx !important;
}

.modal-btn.confirm {
  background: #6c63ff;
  color: #fff;
}

.modal-btn::after {
  border: none;
}
