/* pages/create-character/create-character.wxss */
.create-container {
  min-height: 100vh;
  padding: 60rpx 40rpx 80rpx;
}

.step-wrap { display: flex; flex-direction: column; align-items: center; }

.step-title { text-align: center; margin-bottom: 60rpx; }
.step-num { font-size: 24rpx; color: rgba(255,255,255,0.4); display: block; margin-bottom: 12rpx; }
.step-heading { font-size: 52rpx; font-weight: bold; color: #fff; display: block; margin-bottom: 16rpx; }
.step-desc { font-size: 26rpx; color: rgba(255,255,255,0.6); display: block; }

/* 头像选择 */
.avatar-section {
  width: 100%;
  margin-bottom: 48rpx;
}

.section-title {
  color: rgba(255,255,255,0.7);
  font-size: 28rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.avatar-grid {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: flex-start;
  padding: 4rpx 0;
}

.avatar-item {
  width: calc((100% - 60rpx) / 4);
  aspect-ratio: 1;
}

.avatar-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.avatar-item.selected .avatar-circle {
  border-color: #6c63ff;
  box-shadow: 0 0 20rpx rgba(108,99,255,0.6);
  transform: scale(1.1);
}

.avatar-icon { font-size: 48rpx; }

/* 性别 */
.gender-row {
  display: flex;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

.gender-btn {
  padding: 16rpx 56rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  color: rgba(255,255,255,0.5);
  background: rgba(255,255,255,0.08);
  border: 2rpx solid transparent;
}

.gender-btn.active {
  border-color: #6c63ff;
  color: #fff;
  background: rgba(108,99,255,0.3);
}

/* 名字输入 */
.name-area { width: 100%; margin-bottom: 60rpx; }

.name-input {
  width: 100%;
  box-sizing: border-box;
  display: block;
  background: rgba(255,255,255,0.1);
  border: 1rpx solid rgba(255,255,255,0.25);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  font-size: 36rpx;
  color: #fff;
  text-align: center;
  letter-spacing: 4rpx;
}

/* placeholder 自渲染（绕过 native input 渲染 bug）
   ⚠️ <text> 必须 display:block 且配 left+right 锁定宽度，否则 ellipsis 失效 */
.ph-wrap {
  position: relative;
  width: 100%;
}
.ph {
  display: block;
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 50rpx;
  line-height: 50rpx;
  font-size: 36rpx;
  color: rgba(255,255,255,0.5);
  pointer-events: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.next-btn { width: 80%; }

/* ========== 天赋觉醒选择 ========== */
.awaken-options {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.awaken-card {
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  transition: all 0.2s;
}

.test-card {
  background: rgba(108,99,255,0.12);
  border: 2rpx solid rgba(108,99,255,0.3);
}

.test-card:active {
  background: rgba(108,99,255,0.25);
}

.random-card {
  background: rgba(255,255,255,0.06);
  border: 2rpx solid rgba(255,255,255,0.15);
}

.random-card:active {
  background: rgba(255,255,255,0.12);
}

.awaken-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.test-glow {
  background: rgba(108,99,255,0.25);
  box-shadow: 0 0 20rpx rgba(108,99,255,0.3);
}

.random-glow {
  background: rgba(255,255,255,0.1);
}

.awaken-icon {
  font-size: 44rpx;
}

.awaken-info {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.awaken-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.awaken-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}

.awaken-badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
  width: fit-content;
}

.full-rate {
  background: rgba(108,99,255,0.2);
  color: #a89bff;
}

.reduced-rate {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.4);
}

.awaken-arrow {
  font-size: 32rpx;
  color: rgba(255,255,255,0.3);
  margin-left: 16rpx;
}

/* 随机动画遮罩 */
.rolling-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.rolling-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.rolling-icon {
  font-size: 120rpx;
  animation: glow-spin 0.8s ease-in-out infinite;
}

@keyframes glow-spin {
  0% { transform: scale(1) rotate(0deg); }
  50% { transform: scale(1.2) rotate(10deg); }
  100% { transform: scale(1) rotate(0deg); }
}

.rolling-text {
  font-size: 32rpx;
  color: rgba(255,255,255,0.8);
}

/* ========== 测试答题 ========== */
.progress-bar-wrap {
  width: 100%;
  margin-bottom: 48rpx;
}

.progress-bar-bg {
  width: 100%;
  height: 8rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6c63ff, #a855f7);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.question-card {
  width: 100%;
  box-sizing: border-box;
  background: rgba(255,255,255,0.06);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}

.question-text {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
  line-height: 1.6;
  display: block;
  margin-bottom: 40rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-btn {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.06);
  border: 2rpx solid rgba(255,255,255,0.12);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  transition: all 0.15s;
}

.option-btn:active {
  background: rgba(108,99,255,0.2);
  border-color: #6c63ff;
  transform: scale(0.98);
}

.option-letter {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(108,99,255,0.2);
  color: #a89bff;
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.option-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.5;
}

/* ========== 结果展示 ========== */
.result-badge {
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 50rpx;
  margin-bottom: 32rpx;
  text-align: center;
}

.badge-test {
  background: rgba(108,99,255,0.2);
  color: #a89bff;
  border: 1rpx solid rgba(108,99,255,0.3);
}

.badge-random {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.5);
  border: 1rpx solid rgba(255,255,255,0.15);
}

/* 天赋卡片 */
.talent-reveal { width: 100%; }

.talent-badge {
  border: 2rpx solid;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.talent-category { font-size: 24rpx; display: block; margin-bottom: 12rpx; }
.talent-name { font-size: 44rpx; font-weight: bold; color: #fff; display: block; margin-bottom: 16rpx; }
.talent-desc { font-size: 26rpx; color: rgba(255,255,255,0.7); display: block; }

/* 学习人格总结 */
.personality-card {
  background: rgba(108,99,255,0.1);
  border: 1rpx solid rgba(108,99,255,0.2);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.personality-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.4);
  display: block;
  margin-bottom: 12rpx;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.personality-text {
  font-size: 28rpx;
  color: #a89bff;
  line-height: 1.6;
  display: block;
}

/* 属性预览 */
.attrs-preview {
  background: rgba(255,255,255,0.06);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.attrs-title {
  color: rgba(255,255,255,0.5);
  font-size: 24rpx;
  margin-bottom: 24rpx;
  display: block;
}

.attr-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.attr-label {
  width: 80rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.attr-bar-bg {
  flex: 1;
  height: 12rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 6rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.attr-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.attr-val {
  width: 48rpx;
  text-align: right;
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}

/* 操作按钮 */
.create-actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  align-items: center;
}

.confirm-btn { width: 80%; }
