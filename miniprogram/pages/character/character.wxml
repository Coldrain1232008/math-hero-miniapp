<!-- pages/character/character.wxml -->
<view class="page-bg">

  <!-- 顶部英雄卡片 -->
  <view class="hero-card gradient-bg">
    <view class="hero-header">
      <view class="hero-avatar-wrap">
        <view class="hero-avatar-circle" style="background-color: {{avatarInfo.color}}">
          <text class="hero-avatar-icon">{{avatarInfo.icon}}</text>
        </view>
        <view class="level-badge">Lv.{{levelInfo.level}}</view>
      </view>
      <view class="hero-info">
        <text class="hero-name">{{student.heroName}}</text>
        <view class="talent-tag" style="border-color:{{student.talentColor}};color:{{student.talentColor}}">
          {{student.talentName}}
        </view>
        <view class="title-tag" style="background:{{titleInfo.color}}20;color:{{titleInfo.color}};border-color:{{titleInfo.color}}40">
          {{titleInfo.title}}
        </view>
        <text class="hero-exp">累计经验：{{student.totalExp}} EXP</text>
      </view>
      <view class="notification-bell" bindtap="goNotifications">
        <text class="bell-icon">🔔</text>
        <view class="notification-badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      </view>
    </view>

    <!-- 经验条 -->
    <view wx:if="{{levelInfo.level < 100}}" class="exp-bar-wrap">
      <view class="exp-bar-label">
        <text>距离 Lv.{{levelInfo.level + 1}}</text>
        <text>{{levelInfo.progressExp}} / {{levelInfo.needExp}}</text>
      </view>
      <view class="exp-bar-bg">
        <view class="exp-bar-fill" style="width:{{levelInfo.percent}}%"></view>
      </view>
    </view>
    <view wx:else class="exp-bar-wrap">
      <text class="max-level-text">🏆 满级英雄</text>
    </view>
  </view>

  <!-- 每日签到 -->
  <view class="card checkin-card {{isCheckedIn ? 'checked' : ''}}" bindtap="doCheckIn">
    <view class="checkin-left">
      <text class="checkin-icon">{{isCheckedIn ? '✅' : '📅'}}</text>
      <view class="checkin-info">
        <text class="checkin-title">{{isCheckedIn ? '今日已签到' : '每日签到'}}</text>
        <text class="checkin-desc">{{isCheckedIn ? '连续签到 ' + totalCheckInDays + ' 天' : '签到获得 +5 EXP'}}</text>
      </view>
    </view>
    <button class="checkin-btn {{isCheckedIn ? 'disabled' : ''}}" disabled="{{isCheckedIn || checkingIn}}">
      {{checkingIn ? '签到中...' : isCheckedIn ? '✅' : '签到'}}
    </button>
  </view>

  <!-- 金币资产 -->
  <view class="card coin-card">
    <view class="coin-left">
      <view class="coin-icon-wrap">🪙</view>
      <view class="coin-info">
        <text class="coin-value">{{coins}}</text>
        <text class="coin-sub">累计获得 {{totalCoinsEarned}}</text>
      </view>
    </view>
    <view class="coin-actions">
      <button class="coin-btn ghost" bindtap="goCoinLogs">明细</button>
      <button class="coin-btn" bindtap="openTransfer">赠送</button>
    </view>
  </view>

  <!-- 金币商城入口 -->
  <view class="card shop-entry-card" bindtap="goShop">
    <view class="shop-entry-left">
      <text class="shop-entry-icon">🏪</text>
      <view class="shop-entry-info">
        <text class="shop-entry-title">金币商城</text>
        <text class="shop-entry-desc">用金币兑换抽卡次数、挑战凭证等道具</text>
      </view>
    </view>
    <text class="shop-entry-arrow">›</text>
  </view>

  <!-- 学习周报入口 -->
  <view class="card report-card" bindtap="goWeeklyReport">
    <view class="report-left">
      <text class="report-icon">📊</text>
      <view class="report-info">
        <text class="report-title">学习周报</text>
        <text class="report-desc">查看本周学习数据统计</text>
      </view>
    </view>
    <text class="report-arrow">›</text>
  </view>

  <!-- 雷达图 + 属性 -->
  <view class="card attrs-card">
    <view class="card-title">属性面板</view>
    <view class="radar-container">
      <radar-chart
        attrs="{{attrs}}"
        maxVal="{{maxAttrVal}}"
        size="{{260}}"
        mainColor="{{student.talentColor || '#6c63ff'}}"
      />
    </view>

    <!-- 六属性详细 -->
    <view class="attr-list">
      <view wx:for="{{attrDetail}}" wx:key="name" class="attr-item">
        <text class="attr-dot" style="background:{{item.color}}"></text>
        <text class="attr-name">{{item.name}}</text>
        <view class="attr-bar-bg">
          <view class="attr-bar" style="width:{{item.percent}}%;background:{{item.color}}"></view>
        </view>
        <text class="attr-num">{{item.val}}</text>
      </view>
    </view>

    <!-- 天赋成长率提示 -->
    <view class="growth-hint">
      <text class="growth-title">天赋成长率（每升一级）</text>
      <view class="growth-list">
        <view wx:for="{{growthDetail}}" wx:key="name" class="growth-item">
          <text style="color:{{item.color}}">{{item.name}}</text>
          <text class="growth-val">+{{item.val}}/级</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 幸运转盘入口 -->
  <view class="card gacha-card" bindtap="goGacha">
    <view class="gacha-card-left">
      <text class="gacha-card-icon">🎰</text>
      <view class="gacha-card-info">
        <view class="gacha-card-title">幸运转盘</view>
        <view class="gacha-card-sub">每日{{baseDraw}}次·今日剩余{{dailyDrawLeft}}次 · 概率抽取奖励</view>
      </view>
    </view>
    <view class="gacha-card-right">
      <view class="gacha-vouchers" wx:if="{{challengeVouchers > 0}}">
        <text class="voucher-dot">🏅</text>
        <text class="voucher-num">{{challengeVouchers}}</text>
      </view>
      <text class="gacha-arrow">›</text>
    </view>
  </view>

  <!-- 每日任务卡片 -->
  <view class="card task-card {{dailyTask.isSpecial ? 'special' : ''}}">
    <view class="card-title">
      <text>{{dailyTask.isSpecial ? '⭐ 特殊任务' : '今日任务'}}</text>
      <text class="task-refresh-count" wx:if="{{dailyTask && !dailyTask.isSpecial && dailyTask.refreshCount < 3}}">可刷新 {{3 - dailyTask.refreshCount}} 次</text>
      <text class="task-refresh-count special" wx:if="{{dailyTask && dailyTask.isSpecial}}">老师布置的特殊任务</text>
    </view>
    
    <view wx:if="{{taskLoading}}" class="task-loading">
      <text>加载中...</text>
    </view>
    
    <view wx:elif="{{!dailyTask}}" class="task-empty">
      <text>暂无任务</text>
    </view>
    
    <view wx:else class="task-content">
      <view class="task-header">
        <text class="task-title">{{dailyTask.title}}</text>
        <view class="task-tags">
          <text class="task-tag special" wx:if="{{dailyTask.isSpecial}}">⭐特殊</text>
          <text class="task-tag preference" wx:if="{{dailyTask.isPreference && !dailyTask.isSpecial}}">偏好任务 +5</text>
          <text class="task-tag exp">+{{dailyTask.expReward}} EXP</text>
        </view>
      </view>
      <text class="task-desc">{{dailyTask.desc}}</text>
      
      <view class="task-actions">
        <button
          class="task-btn refresh"
          bindtap="refreshTask"
          disabled="{{dailyTask.refreshCount >= 3 || dailyTask.status !== 'pending' && dailyTask.status !== 'rejected'}}"
          wx:if="{{dailyTask.status === 'pending' || dailyTask.status === 'rejected'}}"
        >
          🔄 刷新
        </button>
        <button
          class="task-btn submit {{dailyTask.status !== 'pending' && dailyTask.status !== 'rejected' ? 'disabled' : ''}} {{dailyTask.isSpecial ? 'special' : ''}}"
          bindtap="submitTask"
          disabled="{{dailyTask.status !== 'pending' && dailyTask.status !== 'rejected'}}"
        >
          {{dailyTask.status === 'pending' ? '✅ 完成任务' : dailyTask.status === 'submitted' ? '⏳ 等待确认' : dailyTask.status === 'rejected' ? '⚠️ 重新提交' : '✓ 已完成'}}
        </button>
      </view>
      <!-- 被驳回提示 -->
      <view wx:if="{{dailyTask.status === 'rejected'}}" class="task-rejected-hint">
        <text>任务被老师驳回了，请重新完成并提交</text>
      </view>
    </view>
  </view>

  <!-- 徽章展示 -->
  <view class="card badge-card">
    <view class="card-title">
      <text>我的徽章</text>
      <text class="badge-manage-btn" bindtap="openBadgeSelector" wx:if="{{badges.length > 0}}">管理</text>
    </view>
    
    <!-- 展示的徽章 -->
    <view wx:if="{{showcasedBadges.length > 0}}" class="showcased-badges">
      <view wx:for="{{showcasedBadges}}" wx:key="badgeId" class="showcased-badge-item" bindtap="showBadgeDetail" data-badge="{{item}}">
        <text class="showcased-badge-icon">{{item.icon}}</text>
        <text class="showcased-badge-name">{{item.badgeName || item.levelName}}</text>
      </view>
    </view>
    
    <!-- 无徽章提示 -->
    <view wx:elif="{{badges.length === 0}}" class="badge-empty">
      <text class="badge-empty-icon">🎖️</text>
      <text class="badge-empty-text">完成任务、登录打卡解锁徽章</text>
    </view>
    
    <!-- 有徽章但未选择展示 -->
    <view wx:else class="badge-empty">
      <text class="badge-empty-text">点击「管理」选择展示徽章</text>
    </view>
    
    <!-- 图鉴入口 -->
    <view class="badge-book-entry" bindtap="goBadgeBook">
      <text>📖 徽章图鉴</text>
      <text class="badge-book-count">{{achievedBadgeCount}}/{{totalBadgeCount}}</text>
      <text class="badge-book-arrow">›</text>
    </view>
  </view>

  <!-- 徽章选择器弹窗 -->
  <view wx:if="{{showBadgeSelector}}" class="modal-mask" bindtap="closeBadgeSelector">
    <view class="modal-box badge-selector-modal" catchtap="preventBubble">
      <view class="modal-title">选择展示徽章（最多3个）</view>
      <view class="badge-selector-list">
        <view wx:for="{{badgeSelectorList}}" wx:key="badgeId" 
          class="badge-selector-item {{item.selected ? 'selected' : ''}}"
          bindtap="toggleBadge" data-badge-id="{{item.badgeId}}">
          <text class="badge-selector-icon">{{item.icon}}</text>
          <view class="badge-selector-info">
            <text class="badge-selector-name">{{item.badgeName || item.levelName}}</text>
            <text class="badge-selector-level" wx:if="{{item.levelName}}">{{item.levelName}}</text>
          </view>
          <view wx:if="{{item.selected}}" class="badge-selector-check">✓</view>
        </view>
      </view>
      <view class="modal-btns">
        <button class="btn-secondary" bindtap="closeBadgeSelector">取消</button>
        <button class="btn-primary" bindtap="saveShowcasedBadges">确认</button>
      </view>
    </view>
  </view>

  <!-- 徽章详情弹窗 -->
  <view wx:if="{{showBadgeDetail}}" class="modal-mask" bindtap="hideBadgeDetail">
    <view class="modal-box badge-detail-modal" catchtap="preventBubble">
      <view class="badge-detail-icon">{{selectedBadge.icon}}</view>
      <text class="badge-detail-name">{{selectedBadge.badgeName || selectedBadge.levelName}}</text>
      <text class="badge-detail-desc" wx:if="{{selectedBadge.desc}}">{{selectedBadge.desc}}</text>
      <view class="badge-detail-info" wx:if="{{selectedBadge.badgeType === 'streak'}}">
        <view class="badge-detail-row">
          <text class="badge-detail-label">当前等级</text>
          <text class="badge-detail-value">{{selectedBadge.levelName}}</text>
        </view>
        <view class="badge-detail-row">
          <text class="badge-detail-label">连续天数</text>
          <text class="badge-detail-value">{{selectedBadge.currentStreak}} 天</text>
        </view>
        <view class="badge-detail-row">
          <text class="badge-detail-label">下一级需要</text>
          <text class="badge-detail-value">{{selectedBadge.requiredDays}} 天</text>
        </view>
        <view class="badge-detail-row" wx:if="{{selectedBadge.isTalentMatch}}">
          <text class="badge-detail-label">天赋加成</text>
          <text class="badge-detail-value talent-match">✅ 匹配天赋，要求降低30%</text>
        </view>
      </view>
      <view class="badge-detail-info" wx:if="{{selectedBadge.badgeType === 'milestone'}}">
        <view class="badge-detail-row">
          <text class="badge-detail-label">状态</text>
          <text class="badge-detail-value">{{selectedBadge.achieved ? '✅ 已解锁' : '🔒 未解锁'}}</text>
        </view>
      </view>
      <button class="btn-primary badge-detail-close" bindtap="hideBadgeDetail">关闭</button>
    </view>
  </view>

  <!-- 重置天赋（如果有机会） -->
  <view wx:if="{{student.rerollChances > 0}}" class="card reroll-card" bindtap="onReroll">
    <text class="reroll-icon">🎲</text>
    <view class="reroll-info">
      <text class="reroll-title">重置天赋机会</text>
      <text class="reroll-desc">你还有 {{student.rerollChances}} 次重置机会，点击重新随机天赋</text>
    </view>
    <text class="reroll-arrow">›</text>
  </view>

  <!-- 修改口令 -->
  <view class="card settings-card" bindtap="showChangeKeyDialog">
    <text class="settings-icon">🔑</text>
    <view class="settings-info">
      <text class="settings-title">修改登录口令</text>
      <text class="settings-desc">设置一个6位以上、只含字母和数字的口令</text>
    </view>
    <text class="settings-arrow">›</text>
  </view>

  <!-- 修改口令弹窗 -->
  <view wx:if="{{showKeyDialog}}" class="modal-mask" bindtap="hideChangeKeyDialog">
    <view class="modal-box" catchtap="preventBubble">
      <text class="modal-title">修改登录口令</text>
      <view class="key-input-group">
        <text class="key-label">当前口令</text>
        <input class="key-input" value="{{student.studentKey}}" disabled />
      </view>
      <view class="key-input-group">
        <text class="key-label">新口令（6位以上字母+数字）</text>
        <view class="ph-wrap">
          <input class="key-input" value="{{newKeyInput}}" bindinput="onNewKeyInput" maxlength="20" />
          <text wx:if="{{!newKeyInput}}" class="ph">例如：abc123</text>
        </view>
      </view>
      <view class="modal-btns">
        <button class="btn-secondary" bindtap="hideChangeKeyDialog">取消</button>
        <button class="btn-primary" bindtap="confirmChangeKey" loading="{{keyChanging}}">确认修改</button>
      </view>
    </view>
  </view>

  <!-- 赠送金币弹窗 -->
  <view wx:if="{{showTransferDialog}}" class="modal-mask" bindtap="closeTransfer">
    <view class="modal-box" catchtap="preventBubble">
      <text class="modal-title">🎁 赠送金币</text>
      <text class="modal-tip coin-tip">
        余额 {{coins}} 金币　今日还可赠 {{todayTransfer.remainTimes}} 次 / {{todayTransfer.remainAmount}} 金币
      </text>

      <view class="key-input-group">
        <text class="key-label">选择同学</text>
      </view>
      <scroll-view scroll-y class="transfer-list">
        <view wx:if="{{loadingClassmates}}" class="transfer-empty">加载中...</view>
        <view wx:elif="{{transferList.length === 0}}" class="transfer-empty">暂无同学</view>
        <view wx:else>
          <view wx:for="{{transferList}}" wx:key="_id" class="transfer-item {{transferTarget._id === item._id ? 'selected' : ''}}" bindtap="selectTransferTarget" data-index="{{index}}">
            <text class="transfer-name">{{item.name}}</text>
            <text class="transfer-lv">Lv.{{item.level}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="key-input-group">
        <text class="key-label">赠送金额（1-20）</text>
        <view class="ph-wrap">
          <input
            class="key-input"
            type="number"
            value="{{transferAmount}}"
            bindinput="onTransferAmountInput"
          />
          <text wx:if="{{!transferAmount}}" class="ph">输入金币数量</text>
        </view>
      </view>
      <view class="key-input-group">
        <text class="key-label">留言（可选，30 字内）</text>
        <view class="ph-wrap">
          <input
            class="key-input"
            value="{{transferNote}}"
            bindinput="onTransferNoteInput"
            maxlength="30"
          />
          <text wx:if="{{!transferNote}}" class="ph">例如：谢谢你帮我讲题</text>
        </view>
      </view>

      <view class="modal-btns">
        <button class="btn-secondary" bindtap="closeTransfer">取消</button>
        <button class="btn-primary" bindtap="submitTransfer" loading="{{transferring}}">确认赠送</button>
      </view>
    </view>
  </view>

  <!-- 经验记录 -->
  <view class="card log-card">
    <view class="card-title">最近经验记录</view>
    <view wx:if="{{expLogs.length === 0}}" class="empty-log">
      <text>暂无记录，等老师给你打第一分 ⚡</text>
    </view>
    <view wx:for="{{expLogs}}" wx:key="_id" class="log-item">
      <view class="log-left">
        <text class="log-type">{{item.typeLabel}}</text>
        <text class="log-desc">{{item.desc}}</text>
      </view>
      <view class="log-right">
        <text class="log-exp">+{{item.exp}} EXP</text>
        <text class="log-time">{{item.timeStr}}</text>
      </view>
    </view>
  </view>

</view>
