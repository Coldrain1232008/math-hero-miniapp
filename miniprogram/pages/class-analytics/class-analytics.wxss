/* pages/class-analytics/class-analytics.wxss */
.page-bg {
  background: #f0f0f8;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.header {
  padding: 60rpx 40rpx 48rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 加载中 */
.loading-wrap {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

/* 数据卡片网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 24rpx;
}

.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #6c63ff;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  margin: 0 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 排行榜 */
.rank-list {
  margin-top: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-no {
  width: 60rpx;
  font-size: 28rpx;
  color: #999;
  text-align: center;
  flex-shrink: 0;
}

.rank-no.top3 {
  font-size: 36rpx;
}

.rank-info {
  flex: 1;
  margin-left: 16rpx;
}

.rank-name {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.rank-level {
  font-size: 22rpx;
  color: #999;
}

.rank-exp {
  font-size: 26rpx;
  color: #6c63ff;
  font-weight: 600;
}

.empty-rank {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
}
