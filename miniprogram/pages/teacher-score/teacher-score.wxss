/* pages/teacher-score/teacher-score.wxss */
.page-bg { background: #f0f0f8; min-height: 100vh; padding-bottom: 80rpx; }

.search-bar { padding: 20rpx 24rpx; }
.search-input {
  background: #fff;
  border-radius: 50rpx;
  padding: 18rpx 32rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}

/* 批量操作栏 */
.batch-bar {
  display: flex;
  align-items: center;
  background: #6c63ff;
  padding: 20rpx 28rpx;
  color: #fff;
  font-size: 26rpx;
  gap: 16rpx;
}
.btn-batch {
  background: rgba(255,255,255,0.25);
  color: #fff;
  border-radius: 40rpx;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  margin: 0;
  border: none;
  flex-shrink: 0;
}
.clear-btn { margin-left: auto; font-size: 24rpx; opacity: 0.7; }

/* 学生列表 */
.student-list { padding: 0 24rpx; }

.student-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 24rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.student-item.selected {
  border-color: #6c63ff;
  background: #f5f3ff;
}

.s-left { display: flex; align-items: center; gap: 20rpx; }
.s-avatar { font-size: 60rpx; }
/* 头像圈：wxml 一直在使用，此前本页 wxss 缺失定义 */
.s-avatar-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.s-avatar-icon { font-size: 36rpx; }
.s-info { }
.s-name { font-size: 30rpx; font-weight: 600; color: #333; display: block; margin-bottom: 6rpx; }
.s-talent { font-size: 22rpx; display: block; }

.s-right { display: flex; align-items: center; gap: 16rpx; }
.s-lv {
  background: linear-gradient(135deg, #f6d365, #fda085);
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 14rpx;
}

.add-btn {
  background: #6c63ff;
  color: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  padding: 10rpx 28rpx;
  margin: 0;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(108,99,255,0.35);
}

/* ============ 模式切换 ============ */
.mode-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx 0;
  gap: 16rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 16rpx 16rpx 0 0;
  background: #f5f5f5;
}

.mode-tab.active {
  background: #6c63ff;
  color: #fff;
  font-weight: bold;
}

/* ============ 钱包余额 ============ */
.wallet-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  padding: 28rpx 32rpx;
  color: #fff;
}

.wallet-left {
  display: flex;
  align-items: center;
}

.wallet-icon {
  font-size: 52rpx;
  margin-right: 20rpx;
}

.wallet-info {
  display: flex;
  flex-direction: column;
}

.wallet-num {
  font-size: 44rpx;
  font-weight: bold;
  line-height: 1.1;
}

.wallet-label {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.wallet-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.wallet-stat {
  font-size: 26rpx;
}

.wallet-hint {
  font-size: 20rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

/* ============ 本次金额 ============ */
.amount-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 32rpx;
  gap: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.amount-label {
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.amount-input {
  width: 160rpx;
  background: #f5f5f5;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 30rpx;
  text-align: center;
  color: #333;
}

/* placeholder 自渲染（绕过 native input 渲染 bug） */
.ph-wrap {
  position: relative;
}
.ph-amount {
  width: 160rpx;
}
.ph-amount .ph {
  display: block;
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 42rpx;
  line-height: 42rpx;
  font-size: 30rpx;
  color: #999;
  pointer-events: none;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}
.ph-search {
  width: 100%;
}
.ph-search .ph {
  display: block;
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 39rpx;
  line-height: 39rpx;
  font-size: 28rpx;
  color: #999;
  pointer-events: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quick-amounts {
  display: flex;
  gap: 12rpx;
  margin-left: auto;
}

.quick-item {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 24rpx;
  color: #666;
}

.quick-item.active {
  background: #f59e0b;
  color: #fff;
  font-weight: bold;
}

/* ============ 批量栏（金币模式） ============ */
.batch-bar {
  flex-wrap: wrap;
}

.batch-total {
  font-size: 24rpx;
  opacity: 0.9;
}

.btn-batch.coin {
  background: #f59e0b;
  color: #fff;
}

.btn-batch.deduct {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

/* ============ 列表金币态 ============ */
.s-coins {
  background: #fffbeb;
  color: #b45309;
  font-size: 22rpx;
  font-weight: bold;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  border: 2rpx solid #fde68a;
}

.add-btn.coin-mode {
  background: #f59e0b;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.35);
}
