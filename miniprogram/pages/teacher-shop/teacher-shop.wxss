/* pages/teacher-shop/teacher-shop.wxss
   教师端商城管理

   项目硬规则：
     - flex 内的 button 必须「死宽度四件套」
       （flex + width + min-width + max-width + padding:0 + text-align:center）
     - placeholder 必须绕开 native 渲染，用 <text> 自渲染：
       <text> 默认 inline，必须 display:block + left/right 锁宽 + top:50% 居中 */

.page {
  padding: 24rpx 24rpx 0;
}

/* ============ 说明条 ============ */
.tip-bar {
  background: #fffbeb;
  border: 2rpx solid #fde68a;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.6;
}

.error-box {
  background: #fef2f2;
  border: 2rpx solid #fecaca;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  color: #b91c1c;
  line-height: 1.6;
}

/* ============ 状态 ============ */
.state-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.state-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.state-text {
  display: block;
  font-size: 30rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.state-sub {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
}

/* ============ 商品卡片 ============ */
.item-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.item-card.is-off {
  opacity: 0.6;
}

.item-top {
  display: flex;
  align-items: flex-start;
}

.item-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #fffbeb;
  border: 2rpx solid #fde68a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1f2937;
  margin-right: 12rpx;
}

.tag-global {
  font-size: 20rpx;
  color: #6c63ff;
  background: #eef2ff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.tag-off {
  font-size: 20rpx;
  color: #9ca3af;
  background: #f3f4f6;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}

.item-desc {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.item-meta {
  display: flex;
  flex-wrap: wrap;
}

.meta-chip {
  font-size: 20rpx;
  color: #6b7280;
  background: #f9fafb;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin: 0 12rpx 8rpx 0;
}

.meta-chip.price {
  color: #b45309;
  background: #fffbeb;
  font-weight: bold;
}

/* ============ 操作按钮组 ============ */
.item-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f3f4f6;
}

.act-btn {
  flex: 0 0 140rpx !important;
  width: 140rpx !important;
  min-width: 140rpx !important;
  max-width: 140rpx !important;
  height: 60rpx !important;
  line-height: 60rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  box-sizing: border-box;
  font-size: 26rpx;
  text-align: center;
  border-radius: 30rpx;
  background: #f3f4f6;
  color: #374151;
  border: none;
  flex-shrink: 0;
}

.act-btn::after {
  border: none;
}

.act-btn.danger {
  background: #fef2f2;
  color: #dc2626;
}

.readonly-tip {
  font-size: 24rpx;
  color: #9ca3af;
}

.bottom-space {
  height: 160rpx;
}

/* ============ 底部新增按钮 ============ */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 2rpx solid #f3f4f6;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
}

.add-btn {
  flex: 0 0 702rpx !important;
  width: 702rpx !important;
  min-width: 702rpx !important;
  max-width: 702rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  box-sizing: border-box;
  font-size: 32rpx;
  text-align: center;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  border: none;
}

.add-btn::after {
  border: none;
}

/* ============ 编辑弹窗 ============ */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-card {
  width: 660rpx;
  max-height: 84vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1f2937;
  text-align: center;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.form-body {
  flex: 1;
  min-height: 0;
  max-height: 60vh;
}

/* ============ 表单行 ============ */
.form-row {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 12rpx;
}

/* placeholder 自渲染：绕过 native input 的渲染 bug
   三件套：display:block + left/right 锁宽 + top:50% 居中，缺一不可 */
.ph-wrap {
  position: relative;
  width: 100%;
}

.form-input {
  width: 100%;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fafafa;
  font-size: 28rpx;
  color: #1f2937;
}

.ph {
  display: block;
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  height: 40rpx;
  line-height: 40rpx;
  font-size: 28rpx;
  color: #9ca3af;
  pointer-events: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 图标选择 */
.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icon-cell {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-sizing: border-box;
}

.icon-cell.selected {
  background: #fffbeb;
  border-color: #f59e0b;
}

/* picker */
.picker-view {
  width: 100%;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fafafa;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-text {
  font-size: 28rpx;
  color: #1f2937;
}

.picker-arrow {
  font-size: 34rpx;
  color: #9ca3af;
}

/* ============ 弹窗按钮 ============ */
.modal-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  flex-shrink: 0;
}

.modal-btn {
  flex: 0 0 283rpx !important;
  width: 283rpx !important;
  min-width: 283rpx !important;
  max-width: 283rpx !important;
  height: 84rpx !important;
  line-height: 84rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  box-sizing: border-box;
  font-size: 30rpx;
  text-align: center;
  border-radius: 42rpx;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn.ghost {
  background: #f3f4f6;
  color: #4b5563;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
}
