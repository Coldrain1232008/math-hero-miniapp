/* pages/weekly-report/weekly-report.wxss */
.page-bg {
  background: #f0f0f8;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.header {
  padding: 60rpx 40rpx 48rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.header-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 加载中 */
.loading-wrap {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

/* 数据卡片网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 24rpx;
}

.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #6c63ff;
  display: block;
  margin-bottom: 8rpx;
}

.stat-value.up {
  color: #10b981;
}

.stat-value.down {
  color: #f5576c;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 柱状图 */
.chart-container {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 300rpx;
  padding-top: 20rpx;
}

.chart-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.chart-bar-bg {
  width: 40rpx;
  height: 200rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.chart-bar {
  width: 100%;
  background: linear-gradient(180deg, #6c63ff, #a78bfa);
  border-radius: 8rpx;
  transition: height 0.6s ease;
  min-height: 4rpx;
}

.chart-bar-value {
  font-size: 20rpx;
  color: #666;
  margin-top: 8rpx;
}

.chart-bar-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 状态行 */
.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.status-row:last-child {
  border-bottom: none;
}

.status-label {
  font-size: 28rpx;
  color: #666;
}

.status-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.status-value.highlight {
  color: #10b981;
}

/* 鼓励卡片 */
.encourage-card {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx;
  display: flex;
  align-items: center;
}

.encourage-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.encourage-text {
  font-size: 28rpx;
  color: #92400e;
  font-weight: 500;
  line-height: 1.5;
}
